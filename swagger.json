{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Get all books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "Array of books",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      },
      "post": {
        "summary": "Create a book",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              },
              "example": {
                "id": "b4",
                "authorId": "a1",
                "title": "Example Book Title",
                "publicationDate": "2026-01-15"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, duplicate book ID, or unknown author ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookError"
                },
                "example": {
                  "message": "Author ID does not exist"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      }
    },
    "/books/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "description": "The custom book ID, such as b1",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get one book by ID",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "Matching book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/BookNotFound"
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      },
      "put": {
        "summary": "Update a book",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookInput"
              },
              "example": {
                "authorId": "a2",
                "title": "Updated Book Title",
                "publicationDate": "2026-02-20"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unknown author ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookError"
                },
                "example": {
                  "message": "Author ID does not exist"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/BookNotFound"
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete a book",
        "tags": [
          "Books"
        ],
        "responses": {
          "204": {
            "description": "Book deleted successfully. No response body."
          },
          "404": {
            "$ref": "#/components/responses/BookNotFound"
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      }
    },
    "/authors": {
      "get": {
        "summary": "Get all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "Array of authors returned successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Create a new author",
        "tags": [
          "Authors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "id": "a4",
                "name": "John Doe",
                "birthYear": 1985
              },
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The custom author id, such as a1"
                  },
                  "name": {
                    "type": "string",
                    "description": "The author's name"
                  },
                  "birthYear": {
                    "type": "integer",
                    "description": "The author's birth year"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "birthYear"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Author created successfully"
          },
          "400": {
            "description": "Bad request (Invalid input or duplicate author ID)"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Get one author by id",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom author id, such as a1",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Author returned successfully"
          },
          "404": {
            "description": "Author not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "summary": "Update an existing author",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom author id, such as a4",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "birthYear"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "birthYear": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "name": "John Doe",
                "birthYear": 1984
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Author updated successfully"
          },
          "400": {
            "description": "Invalid author data"
          },
          "404": {
            "description": "Author not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete an existing author",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom author id, such as a4",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Author deleted successfully. No response body."
          },
          "404": {
            "description": "Author not found"
          },
          "409": {
            "description": "Author is referenced by one or more books"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookInput": {
        "type": "object",
        "required": [
          "authorId",
          "title",
          "publicationDate"
        ],
        "properties": {
          "authorId": {
            "type": "string",
            "description": "The custom ID of an existing author",
            "example": "a1"
          },
          "title": {
            "type": "string",
            "example": "Example Book Title"
          },
          "publicationDate": {
            "type": "string",
            "example": "2026-01-15"
          }
        }
      },
      "Book": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BookInput"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "The custom book ID",
                "example": "b4"
              }
            }
          }
        ]
      },
      "BookError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BookNotFound": {
        "description": "Book not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BookError"
            },
            "example": {
              "message": "Book not found"
            }
          }
        }
      },
      "BookServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BookError"
            },
            "example": {
              "message": "Internal server error"
            }
          }
        }
      }
    }
  },
  "tags": []
}